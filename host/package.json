{
  "name": "ageaf-host",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include .env src/start.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/start.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check --ignore-unknown \"package.json\" \"tsconfig.json\" \"src/auth/**/*.ts\" \"src/diagnostics/**/*.ts\" \"src/transport/**/*.ts\" \"src/routes/diagnostics.ts\" \"src/routes/health.ts\" \"src/routes/pairing.ts\" \"src/doctor.ts\" \"src/native.ts\" \"src/nativeMessaging.ts\" \"src/nativeMessaging/protocol.ts\" \"src/server.ts\" \"src/start.ts\" \"test/cors.test.ts\" \"test/diagnostics.test.ts\" \"test/loopback.test.ts\" \"test/native-messaging-host.test.ts\" \"test/native-messaging-protocol.test.ts\" \"test/pairing.test.ts\"",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run build",
    "native": "tsx src/native.ts",
    "doctor": "tsx src/doctor.ts",
    "auth:reset": "tsx src/auth/reset.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.14",
    "@mariozechner/pi-agent-core": "^0.52.9",
    "@mariozechner/pi-ai": "^0.52.9",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@sinclair/typebox": "^0.34.48",
    "beautiful-mermaid": "^0.1.3",
    "diff": "^8.0.3",
    "dotenv": "^17.2.4",
    "fastify": "^4.26.2",
    "officeparser": "^6.0.4",
    "yaml": "^2.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^20.11.30",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  }
}
